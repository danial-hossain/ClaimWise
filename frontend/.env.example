# ==============================================================================
# ClaimWise Frontend Environment Configuration Template
# Copy this file to .env.local for local Next.js development.
# NEVER commit .env.local to version control.
# ==============================================================================

# FastAPI Backend Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Client Configuration (Public / Safe for Browser)
# NEVER expose the SUPABASE_SERVICE_ROLE_KEY in frontend code!
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
