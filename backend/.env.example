# ==============================================================================
# ClaimWise Backend Environment Configuration Template
# Copy this file to .env and populate with local development or production secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Application Settings
APP_NAME=ClaimWise API
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Authentication Token Signing / Verification (HS256)
# Generate a unique secret of at least 32 characters. Required in production.
JWT_SECRET=
JWT_ISSUER=claimwise
JWT_AUDIENCE=authenticated

# Production also requires DEBUG=false and explicit HTTPS CORS_ORIGINS.
# Do not copy development origins or placeholder database credentials to production.

# AI Components
GEMINI_API_KEY=placeholder_gemini_api_key
