# ==============================================================================
# ClaimWise Backend Environment Configuration Template
# Copy this file to .env and populate with local development or production secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Application Settings
APP_NAME=ClaimWise API
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase project settings dashboard
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-backend-only
DATABASE_URL=postgresql://postgres:placeholder_password@placeholder_host:5432/postgres?sslmode=require

# Supabase Server-Side JWT Verification (Required for strict production authentication)
# Project Settings -> API -> JWT Settings -> JWT Secret (HS256)
SUPABASE_JWT_SECRET=placeholder-supabase-jwt-secret-for-hs256
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://placeholder-project-id.supabase.co/auth/v1

# AI Components
GEMINI_API_KEY=placeholder_gemini_api_key
